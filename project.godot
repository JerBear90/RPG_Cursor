; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Exiled Survivors"
config/description="Dark post-apocalyptic fantasy survival Action RPG — shared-screen co-op prototype."
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/autoload/game_manager.gd"
InputManager="*res://scripts/autoload/input_manager.gd"
ItemDatabase="*res://scripts/utilities/item_database.gd"
SaveManager="*res://scripts/autoload/save_manager.gd"
SceneTransitionManager="*res://scripts/autoload/scene_transition_manager.gd"
InventoryManager="*res://scripts/autoload/inventory_manager.gd"
CurrencyManager="*res://scripts/autoload/currency_manager.gd"
QuestManager="*res://scripts/autoload/quest_manager.gd"
MapManager="*res://scripts/autoload/map_manager.gd"
LootManager="*res://scripts/autoload/loot_manager.gd"
CraftingManager="*res://scripts/autoload/crafting_manager.gd"
BaseManager="*res://scripts/autoload/base_manager.gd"
WaystoneManager="*res://scripts/autoload/waystone_manager.gd"
DialogueManager="*res://scripts/autoload/dialogue_manager.gd"
AchievementManager="*res://scripts/autoload/achievement_manager.gd"
PetManager="*res://scripts/autoload/pet_manager.gd"
PlayerProgress="*res://scripts/utilities/player_progress.gd"
DungeonManager="*res://scripts/autoload/dungeon_manager.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"
MerchantManager="*res://scripts/autoload/merchant_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

