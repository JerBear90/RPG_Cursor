CryptState="*res://scripts/autoload/crypt_state.gd"
CitadelState="*res://scripts/autoload/citadel_state.gd"
CathedralState="*res://scripts/autoload/cathedral_state.gd"
PyreheartState="*res://scripts/autoload/pyreheart_state.gd"
EclipseSanctumState="*res://scripts/autoload/eclipse_sanctum_state.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
SettingsManager="*res://scripts/autoload/settings_manager.gd"
MerchantManager="*res://scripts/autoload/merchant_manager.gd"
CombatVfx="*res://scripts/combat/combat_vfx.gd"
MaskManager="*res://scripts/autoload/mask_manager.gd"
ResourceFeedbackManager="*res://scripts/autoload/resource_feedback_manager.gd"
CombatExperienceManager="*res://scripts/autoload/combat_experience_manager.gd"
WorldStateManager="*res://scripts/autoload/world_state_manager.gd"
LevelRestartService="*res://scripts/autoload/level_restart_service.gd"
RegionTransitionManager="*res://scripts/autoload/region_transition_manager.gd"
NpcStateManager="*res://scripts/autoload/npc_state_manager.gd"
NpcMissionHooks="*res://scripts/autoload/npc_mission_hooks.gd"
ObjectiveRouter="*res://scripts/autoload/objective_router.gd"
TutorialPromptManager="*res://scripts/autoload/tutorial_prompt_manager.gd"
VerticalSliceFlow="*res://scripts/autoload/vertical_slice_flow.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

